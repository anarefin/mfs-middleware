<?xml version="1.0" encoding="UTF-8"?>
<!-- Reviewed SpotBugs false positives only; each Match says why. -->
<FindBugsFilter>
  <!-- Constructor-injected Spring beans (JdbcTemplate, JsonMapper, ProducerTemplate, ...) are
       shared singletons by design; copying them is impossible and wrong. Records in dto/ are
       still checked. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Not><Package name="~.*\.dto"/></Not>
  </Match>
  <!-- X-Correlation-Id is echoed only after matching [A-Za-z0-9._:-]{1,128}; anything else is
       replaced by a UUID, so no CR/LF can reach the header. -->
  <Match>
    <Class name="~.*\.filter\.CorrelationIdFilter"/>
    <Method name="doFilterInternal"/>
    <Bug pattern="HRS_REQUEST_PARAMETER_TO_HTTP_HEADER"/>
  </Match>
</FindBugsFilter>
