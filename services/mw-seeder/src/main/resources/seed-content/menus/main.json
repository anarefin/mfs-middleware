    "p2p.recipient": {
      "type": "INPUT",
      "text": {
        "bn": "প্রাপকের Bits নম্বর দিন",
        "en": "Enter recipient Bits number"
      },
      "validator": {
        "type": "msisdn",
        "notSelf": true,
        "error": {
          "bn": "সঠিক মোবাইল নম্বর দিন।",
          "en": "Enter a valid mobile number."
        }
      },
      "store": "recipient",
      "next": "p2p.amount"
    },
    "p2p.amount": {
      "type": "INPUT",
      "text": {
        "bn": "টাকার পরিমাণ দিন",
        "en": "Enter amount (Tk)"
      },
      "validator": {
        "type": "amount",
        "min": "10",
        "max": "25000",
        "error": {
          "bn": "পরিমাণ ১০ থেকে ২৫০০০ টাকার মধ্যে দিন।",
          "en": "Enter an amount from Tk 10 to 25000."
        }
      },
      "store": "amount",
      "next": "p2p.confirm"
    },
    "p2p.confirm": {
      "type": "CONFIRM",
      "text": {
        "bn": "{recipient} নম্বরে {amount} টাকা, ফি {fee}?",
        "en": "Send Tk {amount} to {recipient}?\nFee Tk {fee}"
      },
      "options": [
        {
          "key": "1",
          "label": {
            "bn": "নিশ্চিত করুন",
            "en": "Confirm"
          },
          "next": "p2p.pin"
        },
        {
          "key": "2",
          "label": {
            "bn": "বাতিল",
            "en": "Cancel"
          },
          "next": "cancelled"
        }
      ],
      "lookup": "charges",
      "mapping": {
        "txnType": "=P2P",
        "amount": "amount"
      }
    },
    "p2p.pin": {
      "type": "INPUT",
      "text": {
        "bn": "আপনার পিন দিন",
        "en": "Enter your PIN"
      },
      "validator": {
        "type": "pin",
        "error": {
          "bn": "পিন ৫ অঙ্কের।",
          "en": "The PIN has 5 digits."
        }
      },
      "next": "p2p.send"
    },
    "p2p.send": {
      "type": "ACTION",
      "flow": "P2P",
      "mapping": {
        "creditParty": "recipient",
        "amount": "amount"
      },
      "onSuccess": "p2p.done",
      "onFailure": "p2p.failed"
    },
