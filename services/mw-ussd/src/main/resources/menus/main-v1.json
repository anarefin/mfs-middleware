{
  "menuId": "main",
  "version": 1,
  "start": "main",
  "messages": {
    "invalid": { "bn": "ভুল ইনপুট।", "en": "Invalid input." },
    "tooManyAttempts": { "bn": "অনেকবার ভুল ইনপুট। আবার চেষ্টা করুন।", "en": "Too many invalid entries. Please try again." },
    "expired": { "bn": "সেশন শেষ হয়েছে। আবার ডায়াল করুন।", "en": "Session expired. Please dial again." },
    "processing": { "bn": "আপনার অনুরোধ প্রক্রিয়াধীন। ফলাফল SMS-এ জানানো হবে।", "en": "Your request is being processed. You will get the result by SMS." },
    "unavailable": { "bn": "সেবাটি সাময়িকভাবে বন্ধ। পরে চেষ্টা করুন।", "en": "Service temporarily unavailable. Please try later." },
    "more": { "bn": "0 আরও", "en": "0 More" }
  },
  "nodes": {
    "main": {
      "type": "MENU",
      "text": { "bn": "upay", "en": "upay" },
      "options": [
        { "key": "1", "label": { "bn": "সেন্ড মানি", "en": "Send Money" }, "next": "p2p.recipient" },
        { "key": "9", "label": { "bn": "English", "en": "বাংলা" }, "next": "main", "switchLanguage": true }
      ]
    },
    "p2p.recipient": {
      "type": "INPUT",
      "text": { "bn": "প্রাপকের upay নম্বর দিন", "en": "Enter recipient upay number" },
      "validator": {
        "type": "msisdn",
        "notSelf": true,
        "error": { "bn": "সঠিক মোবাইল নম্বর দিন।", "en": "Enter a valid mobile number." }
      },
      "store": "recipient",
      "next": "p2p.amount"
    },
    "p2p.amount": {
      "type": "INPUT",
      "text": { "bn": "টাকার পরিমাণ দিন", "en": "Enter amount (Tk)" },
      "validator": {
        "type": "amount",
        "min": "10",
        "max": "25000",
        "error": { "bn": "পরিমাণ ১০ থেকে ২৫০০০ টাকার মধ্যে দিন।", "en": "Enter an amount from Tk 10 to 25000." }
      },
      "store": "amount",
      "next": "p2p.confirm"
    },
    "p2p.confirm": {
      "type": "CONFIRM",
      "text": { "bn": "{recipient} নম্বরে {amount} টাকা পাঠাবেন?", "en": "Send Tk {amount} to {recipient}?" },
      "options": [
        { "key": "1", "label": { "bn": "নিশ্চিত করুন", "en": "Confirm" }, "next": "p2p.pin" },
        { "key": "2", "label": { "bn": "বাতিল", "en": "Cancel" }, "next": "cancelled" }
      ]
    },
    "p2p.pin": {
      "type": "INPUT",
      "text": { "bn": "আপনার পিন দিন", "en": "Enter your PIN" },
      "validator": {
        "type": "pin",
        "error": { "bn": "পিন ৪ অঙ্কের।", "en": "The PIN has 4 digits." }
      },
      "next": "p2p.send"
    },
    "p2p.send": {
      "type": "ACTION",
      "flow": "P2P",
      "mapping": { "creditParty": "recipient", "amount": "amount" },
      "onSuccess": "p2p.done",
      "onFailure": "p2p.failed"
    },
    "p2p.done": {
      "type": "END",
      "text": { "bn": "{recipient} নম্বরে {amount} টাকা পাঠানো হয়েছে।", "en": "Tk {amount} sent to {recipient}. TxnID {txnId}" }
    },
    "p2p.failed": {
      "type": "END",
      "text": { "bn": "সেন্ড মানি ব্যর্থ: {error}", "en": "Send Money failed: {error}" }
    },
    "cancelled": {
      "type": "END",
      "text": { "bn": "বাতিল করা হয়েছে।", "en": "Cancelled." }
    }
  }
}
