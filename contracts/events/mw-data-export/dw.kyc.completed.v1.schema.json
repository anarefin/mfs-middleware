{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bits.mw/events/mw-data-export/dw.kyc.completed.v1.schema.json",
  "title": "dw.kyc.completed.v1",
  "description": "DW projection of a completed KYC (FRS DAT-01, ticket 128). walletToken is a token. The source topic arrives with ticket 124.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "walletToken",
    "kycLevel",
    "completedAt",
    "correlationId"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "walletToken": {
      "type": "string",
      "minLength": 1
    },
    "kycLevel": {
      "type": "string",
      "minLength": 1
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    }
  }
}
