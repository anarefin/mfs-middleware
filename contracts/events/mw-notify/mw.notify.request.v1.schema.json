{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.upay.mw/events/mw-notify/mw.notify.request.v1.schema.json",
  "title": "mw.notify.request.v1",
  "description": "NotificationRequest (spec 10.1). Any service produces it; mw-notify consumes and owns it. Key: recipient. messageId is the idempotency key; duplicates are dropped.",
  "type": "object",
  "required": ["schemaVersion", "messageId", "recipient", "templateCode", "locale", "channels", "priority"],
  "properties": {
    "schemaVersion": { "$ref": "../../common/defs.v1.schema.json#/$defs/SchemaVersion", "const": 1 },
    "messageId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "txnId": { "$ref": "../../common/defs.v1.schema.json#/$defs/TxnId" },
    "correlationId": { "$ref": "../../common/defs.v1.schema.json#/$defs/CorrelationId" },
    "recipient": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "msisdn": { "$ref": "../../common/defs.v1.schema.json#/$defs/Msisdn" },
        "email": { "type": "string", "format": "email" },
        "pushToken": { "type": "string", "minLength": 1 },
        "subjectId": { "type": "string", "minLength": 1 }
      }
    },
    "templateCode": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
    "locale": { "$ref": "../../common/defs.v1.schema.json#/$defs/Locale" },
    "params": { "$ref": "../../common/defs.v1.schema.json#/$defs/StringMap" },
    "channels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["SMS", "EMAIL", "PUSH"] } },
    "priority": { "enum": ["OTP", "TXN", "INFO", "PROMO"] },
    "sendAt": { "type": "string", "format": "date-time" },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "Defaults: OTP 2 min, TXN 24 h. Expired messages are recorded as EXPIRED."
    }
  }
}
