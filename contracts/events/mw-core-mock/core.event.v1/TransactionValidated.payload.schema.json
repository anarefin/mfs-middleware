{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.upay.mw/events/mw-core-mock/core.event.v1/TransactionValidated.payload.schema.json",
  "title": "core.event.v1 TransactionValidated payload",
  "description": "Success of ValidateTransaction: fee, charges and limits left.",
  "type": "object",
  "properties": {
    "fee": { "$ref": "../../../common/defs.v1.schema.json#/$defs/Amount" },
    "charges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "amount"],
        "properties": { "code": { "type": "string" }, "amount": { "$ref": "../../../common/defs.v1.schema.json#/$defs/Amount" } }
      }
    },
    "limitsLeft": {
      "type": "object",
      "additionalProperties": { "$ref": "../../../common/defs.v1.schema.json#/$defs/Amount" },
      "description": "Remaining limit per limit code."
    }
  }
}
