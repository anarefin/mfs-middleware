{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bits.mw/events/mw-core-mock/core.event.v1/TransactionStatus.payload.schema.json",
  "title": "core.event.v1 TransactionStatus payload",
  "description": "Answer to QueryTransaction: the core's view of the transaction.",
  "type": "object",
  "required": ["txnStatus"],
  "properties": {
    "txnStatus": {
      "enum": ["NOT_FOUND", "VALIDATED", "HELD", "COMMITTED", "RELEASED", "POSTED", "CREDITED", "REVERSED", "REJECTED"]
    },
    "holdId": { "type": "string", "minLength": 1 }
  }
}
