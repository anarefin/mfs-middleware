{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.upay.mw/events/mw-orchestrator/mw.partner.inbound.v1/bank.payload.schema.json",
  "title": "mw.partner.inbound.v1 bank payload",
  "description": "Partner-initiated message received by adapter-bank (bank transfers, UCB IMT remittance, ATM). A CALLBACK carries the final outcome of an earlier request; REMITTANCE and NPSB_CREDIT carry new inbound money.",
  "type": "object",
  "required": ["kind"],
  "properties": {
    "kind": { "enum": ["CALLBACK", "REMITTANCE", "NPSB_CREDIT"] },
    "outcome": { "enum": ["SUCCESS", "FAILED", "PENDING"] },
    "partnerCode": { "type": "string" },
    "errorCode": { "type": "string", "pattern": "^MW-PTR-[A-Z0-9_]+-[A-Z0-9_]+$" },
    "txnType": { "$ref": "../../../common/defs.v1.schema.json#/$defs/TxnType" },
    "amount": { "$ref": "../../../common/defs.v1.schema.json#/$defs/Amount" },
    "creditParty": { "$ref": "../../../common/defs.v1.schema.json#/$defs/Party" },
    "attributes": { "$ref": "../../../common/defs.v1.schema.json#/$defs/StringMap" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "CALLBACK" } }, "required": ["kind"] },
      "then": { "required": ["outcome"] }
    },
    {
      "if": { "properties": { "kind": { "enum": ["REMITTANCE", "NPSB_CREDIT"] } }, "required": ["kind"] },
      "then": { "required": ["txnType", "amount", "creditParty"] }
    }
  ]
}
