{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bits.mw/events/mw-orchestrator/mw.txn.status.v1.schema.json",
  "title": "mw.txn.status.v1",
  "description": "Transaction state change published by mw-orchestrator (spec 5.1, 6.2, 7.2). Key: txnId. Consumers: channel services, notify, audit-dw.",
  "type": "object",
  "required": ["schemaVersion", "txnId", "correlationId", "channel", "txnType", "status", "amount", "requestedAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "$ref": "../../common/defs.v1.schema.json#/$defs/SchemaVersion", "const": 1 },
    "txnId": { "$ref": "../../common/defs.v1.schema.json#/$defs/TxnId" },
    "idempotencyKey": { "$ref": "../../common/defs.v1.schema.json#/$defs/IdempotencyKey" },
    "correlationId": { "$ref": "../../common/defs.v1.schema.json#/$defs/CorrelationId" },
    "channel": { "$ref": "../../common/defs.v1.schema.json#/$defs/Channel" },
    "txnType": { "$ref": "../../common/defs.v1.schema.json#/$defs/TxnType" },
    "status": { "$ref": "#/$defs/Status" },
    "previousStatus": { "$ref": "#/$defs/Status" },
    "initiator": { "$ref": "../../common/defs.v1.schema.json#/$defs/Party" },
    "debitParty": { "$ref": "../../common/defs.v1.schema.json#/$defs/Party" },
    "creditParty": { "$ref": "../../common/defs.v1.schema.json#/$defs/Party" },
    "amount": { "$ref": "../../common/defs.v1.schema.json#/$defs/Amount" },
    "fee": { "$ref": "../../common/defs.v1.schema.json#/$defs/Amount" },
    "partner": { "$ref": "../../common/defs.v1.schema.json#/$defs/PartnerRef" },
    "partnerRef": { "type": "string", "description": "Partner's own reference, filled on partner response." },
    "coreRef": { "type": "string", "description": "Core ledger reference, filled on core event." },
    "originalTxnId": { "$ref": "../../common/defs.v1.schema.json#/$defs/TxnId" },
    "error": { "$ref": "#/$defs/Error" },
    "requestedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "locale": { "$ref": "../../common/defs.v1.schema.json#/$defs/Locale" },
    "attributes": { "$ref": "../../common/defs.v1.schema.json#/$defs/StringMap" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["FAILED", "REJECTED", "MANUAL_REVIEW"] } }, "required": ["status"] },
      "then": { "required": ["error"] }
    }
  ],
  "$defs": {
    "Status": {
      "enum": ["RECEIVED", "VALIDATING", "HOLDING", "POSTING", "PARTNER_PENDING", "UNKNOWN", "COMMITTING", "RELEASING", "REVERSING", "COMPLETED", "FAILED", "REJECTED", "REVERSED", "MANUAL_REVIEW"]
    },
    "Error": {
      "type": "object",
      "description": "Error envelope subset (spec 5.3).",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^MW-(VAL|AUTH|IDEM|CORE|TMO|SYS|PTR-[A-Z0-9_]+)-[A-Z0-9_]+$" },
        "message": { "type": "string" },
        "messageBn": { "type": "string" },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
