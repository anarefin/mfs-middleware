{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bits.mw/events/mw-orchestrator/mw.partner.request.v1.schema.json",
  "title": "mw.partner.request.v1",
  "description": "Canonical partner request from mw-orchestrator to an adapter (spec 6.2, 11.2), on mw.partner.request.<family>.v1. Key: txnId. The payload is picked by family; the adapter maps it to the partner's API.",
  "type": "object",
  "required": ["schemaVersion", "family", "requestId", "txnId", "correlationId", "issuedAt", "deadlineAt", "payload"],
  "properties": {
    "schemaVersion": { "$ref": "../../common/defs.v1.schema.json#/$defs/SchemaVersion", "const": 1 },
    "family": { "enum": ["telco", "billpay", "bank", "interop", "compliance"] },
    "requestId": { "type": "string", "format": "uuid", "description": "Unique per request; echoed on the reply." },
    "txnId": { "$ref": "../../common/defs.v1.schema.json#/$defs/TxnId" },
    "correlationId": { "$ref": "../../common/defs.v1.schema.json#/$defs/CorrelationId" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "deadlineAt": {
      "type": "string",
      "format": "date-time",
      "description": "After this instant the orchestrator treats the call as UNKNOWN."
    },
    "payload": {
      "type": "object",
      "description": "One oneOf branch per family; today every family refs the shared mw.partner.request.v1/shared.payload.schema.json (contracts/README.md: splitting a family out)."
    }
  },
  "discriminator": { "propertyName": "family" },
  "oneOf": [
    {
      "properties": { "family": { "const": "telco" }, "payload": { "$ref": "mw.partner.request.v1/shared.payload.schema.json" } }
    },
    {
      "properties": { "family": { "const": "billpay" }, "payload": { "$ref": "mw.partner.request.v1/shared.payload.schema.json" } }
    },
    {
      "properties": { "family": { "const": "bank" }, "payload": { "$ref": "mw.partner.request.v1/shared.payload.schema.json" } }
    },
    {
      "properties": { "family": { "const": "interop" }, "payload": { "$ref": "mw.partner.request.v1/shared.payload.schema.json" } }
    },
    {
      "properties": { "family": { "const": "compliance" }, "payload": { "$ref": "mw.partner.request.v1/shared.payload.schema.json" } }
    }
  ]
}
