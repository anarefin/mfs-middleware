{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bits.mw/events/mw-orchestrator/core.command.v1/HoldFunds.payload.schema.json",
  "title": "core.command.v1 HoldFunds payload",
  "description": "Reserve the debit amount and fee for a transaction that needs an external call. Needs customer authorisation: it carries mw-auth's assertion (spec 18.7, D22) or, until ticket 72, the deprecated encryptedPin (spec 6.3), exactly one of them. With an assertion the payload also carries the request's idempotencyKey, which the core needs to recompute the assertion's txnHash.",
  "type": "object",
  "required": ["txnType", "debitParty", "creditParty", "amount"],
  "oneOf": [{ "required": ["assertion"] }, { "required": ["encryptedPin"] }],
  "dependentRequired": { "assertion": ["idempotencyKey"] },
  "properties": {
    "txnType": { "$ref": "../../../common/defs.v1.schema.json#/$defs/TxnType" },
    "debitParty": { "$ref": "../../../common/defs.v1.schema.json#/$defs/Party" },
    "creditParty": { "$ref": "../../../common/defs.v1.schema.json#/$defs/Party" },
    "amount": { "$ref": "../../../common/defs.v1.schema.json#/$defs/Amount" },
    "fee": { "$ref": "../../../common/defs.v1.schema.json#/$defs/Amount" },
    "assertion": { "$ref": "../../../common/defs.v1.schema.json#/$defs/TxnAssertion" },
    "idempotencyKey": {
      "$ref": "../../../common/defs.v1.schema.json#/$defs/IdempotencyKey",
      "description": "The mw.txn.request.v1 idempotencyKey; part of the assertion's txnHash."
    },
    "encryptedPin": {
      "$ref": "../../../common/defs.v1.schema.json#/$defs/EncryptedPin",
      "deprecated": true,
      "description": "Deprecated (D22), removed in ticket 72."
    },
    "attributes": { "$ref": "../../../common/defs.v1.schema.json#/$defs/StringMap" }
  }
}
