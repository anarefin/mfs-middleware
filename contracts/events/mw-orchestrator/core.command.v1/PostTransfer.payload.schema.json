{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bits.mw/events/mw-orchestrator/core.command.v1/PostTransfer.payload.schema.json",
  "title": "core.command.v1 PostTransfer payload",
  "description": "One-step debit and credit when no external party is involved (P2P, cash in/out). Needs customer authorisation, so it carries encryptedPin (spec 6.3), except BULK_DISBURSE: the org authorised the whole batch by maker-checker in the org portal (ticket 34), so a bulk child carries no PIN.",
  "type": "object",
  "required": ["txnType", "debitParty", "creditParty", "amount"],
  "if": { "properties": { "txnType": { "not": { "const": "BULK_DISBURSE" } } } },
  "then": { "required": ["encryptedPin"] },
  "properties": {
    "txnType": { "$ref": "../../../common/defs.v1.schema.json#/$defs/TxnType" },
    "debitParty": { "$ref": "../../../common/defs.v1.schema.json#/$defs/Party" },
    "creditParty": { "$ref": "../../../common/defs.v1.schema.json#/$defs/Party" },
    "amount": { "$ref": "../../../common/defs.v1.schema.json#/$defs/Amount" },
    "fee": { "$ref": "../../../common/defs.v1.schema.json#/$defs/Amount" },
    "encryptedPin": { "$ref": "../../../common/defs.v1.schema.json#/$defs/EncryptedPin" },
    "attributes": { "$ref": "../../../common/defs.v1.schema.json#/$defs/StringMap" }
  }
}
