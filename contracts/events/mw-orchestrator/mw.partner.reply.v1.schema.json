{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.upay.mw/events/mw-orchestrator/mw.partner.reply.v1.schema.json",
  "title": "mw.partner.reply.v1",
  "description": "Adapter reply to a partner request (spec 6.2, 11.2). Key: txnId. Produced by every adapter, consumed by mw-orchestrator, which owns the contract. The payload is picked by family.",
  "type": "object",
  "required": ["schemaVersion", "family", "requestId", "txnId", "correlationId", "partnerId", "repliedAt", "payload"],
  "properties": {
    "schemaVersion": { "$ref": "../../common/defs.v1.schema.json#/$defs/SchemaVersion", "const": 1 },
    "family": { "enum": ["telco", "billpay", "bank", "interop", "compliance"] },
    "requestId": { "type": "string", "format": "uuid" },
    "txnId": { "$ref": "../../common/defs.v1.schema.json#/$defs/TxnId" },
    "correlationId": { "$ref": "../../common/defs.v1.schema.json#/$defs/CorrelationId" },
    "partnerId": { "type": "string", "minLength": 1 },
    "repliedAt": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "description": "Shape depends on family: one payload schema per message type in mw.partner.reply.v1/."
    }
  },
  "discriminator": { "propertyName": "family" },
  "oneOf": [
    {
      "properties": { "family": { "const": "telco" }, "payload": { "$ref": "mw.partner.reply.v1/telco.payload.schema.json" } }
    },
    {
      "properties": { "family": { "const": "billpay" }, "payload": { "$ref": "mw.partner.reply.v1/billpay.payload.schema.json" } }
    },
    {
      "properties": { "family": { "const": "bank" }, "payload": { "$ref": "mw.partner.reply.v1/bank.payload.schema.json" } }
    },
    {
      "properties": { "family": { "const": "interop" }, "payload": { "$ref": "mw.partner.reply.v1/interop.payload.schema.json" } }
    },
    {
      "properties": {
        "family": { "const": "compliance" },
        "payload": { "$ref": "mw.partner.reply.v1/compliance.payload.schema.json" }
      }
    }
  ]
}
