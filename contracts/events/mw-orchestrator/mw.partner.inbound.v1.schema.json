{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.upay.mw/events/mw-orchestrator/mw.partner.inbound.v1.schema.json",
  "title": "mw.partner.inbound.v1",
  "description": "Partner-initiated message (callback, inbound remittance, NPSB credit) published by an adapter after signature check and dedup on partnerRef (spec 6.2, 11.2). Key: txnId (minted by the adapter for new inbound money). Owned by mw-orchestrator, its only consumer. The payload is picked by family.",
  "type": "object",
  "required": ["schemaVersion", "family", "inboundId", "txnId", "correlationId", "partnerId", "partnerRef", "receivedAt", "payload"],
  "properties": {
    "schemaVersion": { "$ref": "../../common/defs.v1.schema.json#/$defs/SchemaVersion", "const": 1 },
    "family": { "enum": ["telco", "billpay", "bank", "interop", "compliance"] },
    "inboundId": { "type": "string", "format": "uuid" },
    "txnId": { "$ref": "../../common/defs.v1.schema.json#/$defs/TxnId" },
    "correlationId": { "$ref": "../../common/defs.v1.schema.json#/$defs/CorrelationId" },
    "partnerId": { "type": "string", "minLength": 1 },
    "partnerRef": { "type": "string", "minLength": 1 },
    "receivedAt": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "description": "One oneOf branch per family; today every family refs the shared mw.partner.inbound.v1/shared.payload.schema.json (contracts/README.md: splitting a family out)."
    }
  },
  "discriminator": { "propertyName": "family" },
  "oneOf": [
    {
      "properties": { "family": { "const": "telco" }, "payload": { "$ref": "mw.partner.inbound.v1/shared.payload.schema.json" } }
    },
    {
      "properties": { "family": { "const": "billpay" }, "payload": { "$ref": "mw.partner.inbound.v1/shared.payload.schema.json" } }
    },
    {
      "properties": { "family": { "const": "bank" }, "payload": { "$ref": "mw.partner.inbound.v1/shared.payload.schema.json" } }
    },
    {
      "properties": { "family": { "const": "interop" }, "payload": { "$ref": "mw.partner.inbound.v1/shared.payload.schema.json" } }
    },
    {
      "properties": { "family": { "const": "compliance" }, "payload": { "$ref": "mw.partner.inbound.v1/shared.payload.schema.json" } }
    }
  ]
}
