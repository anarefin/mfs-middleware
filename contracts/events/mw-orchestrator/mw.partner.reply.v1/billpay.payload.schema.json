{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.upay.mw/events/mw-orchestrator/mw.partner.reply.v1/billpay.payload.schema.json",
  "title": "mw.partner.reply.v1 billpay payload",
  "description": "Reply from adapter-billpay (utility and other bills). FAILED carries a canonical errorCode (spec 5.3); SUCCESS carries the partner's reference.",
  "type": "object",
  "required": ["operation", "outcome"],
  "properties": {
    "operation": { "enum": ["PAY", "INQUIRY", "STATUS_QUERY", "REVERSE", "SCREEN"] },
    "outcome": { "enum": ["SUCCESS", "FAILED", "UNKNOWN", "PENDING"] },
    "partnerRef": { "type": "string", "description": "Partner's own reference." },
    "partnerCode": { "type": "string", "description": "Raw partner result code, for audit." },
    "errorCode": {
      "type": "string",
      "pattern": "^MW-(PTR-[A-Z0-9_]+|TMO|SYS|VAL)-[A-Z0-9_]+$",
      "description": "Canonical code mapped from the partner code (spec 5.3)."
    },
    "message": { "type": "string" },
    "retryable": { "type": "boolean" },
    "attributes": { "$ref": "../../../common/defs.v1.schema.json#/$defs/StringMap" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "FAILED" } }, "required": ["outcome"] },
      "then": { "required": ["errorCode"] }
    },
    {
      "if": { "properties": { "outcome": { "const": "SUCCESS" } }, "required": ["outcome"] },
      "then": { "required": ["partnerRef"] }
    }
  ]
}
