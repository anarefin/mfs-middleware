{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.upay.mw/events/mw-orchestrator/mw.txn.request.v1.schema.json",
  "title": "mw.txn.request.v1",
  "description": "Transaction request from a channel service to mw-orchestrator (spec 5.1, 6.2). Key: txnId. Consumers ignore unknown fields; only additive changes within v1.",
  "type": "object",
  "required": ["schemaVersion", "txnId", "idempotencyKey", "correlationId", "channel", "txnType", "initiator", "debitParty", "creditParty", "amount", "requestedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "txnId": { "$ref": "#/$defs/TxnId" },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 64 },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "channel": { "enum": ["CUSTOMER_APP", "AGENT_APP", "MERCHANT_APP", "DISTRIBUTOR_APP", "DSO_APP", "PARTNER_APP", "USSD", "WEB_CHECKOUT", "ORG_PORTAL", "SP_PORTAL", "PARTNER_API", "SYSTEM"] },
    "txnType": { "enum": ["P2P", "CASH_IN", "CASH_OUT", "ATM_CASH_OUT", "ATM_CASH_IN", "TOPUP", "BILL_PAY", "MERCHANT_PAY", "ADD_MONEY_CARD", "ADD_MONEY_BANK", "C2W", "W2B", "REMIT_IN", "QR_PAY_INTEROP", "BULK_DISBURSE", "REVERSAL"] },
    "initiator": { "$ref": "#/$defs/Party" },
    "debitParty": { "$ref": "#/$defs/Party" },
    "creditParty": { "$ref": "#/$defs/Party" },
    "amount": { "$ref": "#/$defs/Money" },
    "partner": { "$ref": "#/$defs/PartnerRef" },
    "originalTxnId": { "$ref": "#/$defs/TxnId", "description": "Set for REVERSAL: the transaction being compensated." },
    "encryptedPin": { "$ref": "#/$defs/EncryptedPin" },
    "requestedAt": { "type": "string", "format": "date-time" },
    "locale": { "enum": ["bn", "en"] },
    "metadata": { "$ref": "#/$defs/StringMap", "description": "Channel extras (device ID, USSD session, IP); masked by policy." },
    "attributes": { "$ref": "#/$defs/StringMap", "description": "Product-specific data (bill number, meter number, account number)." }
  },
  "allOf": [
    { "if": { "properties": { "txnType": { "const": "REVERSAL" } }, "required": ["txnType"] }, "then": { "required": ["originalTxnId"] } }
  ],
  "$defs": {
    "TxnId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "description": "UUIDv7, lower case." },
    "Money": {
      "type": "object",
      "required": ["valueMinor", "currency"],
      "properties": {
        "valueMinor": { "type": "integer", "minimum": 0, "description": "Amount in minor units (poisha); never a decimal on the wire." },
        "currency": { "const": "BDT" }
      }
    },
    "Party": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["WALLET", "BANK_ACCOUNT", "CARD_TOKEN", "BILLER_ACCOUNT", "MSISDN", "MERCHANT", "ORG"] },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "walletType": { "enum": ["CUSTOMER", "AGENT", "MERCHANT", "DISTRIBUTOR", "DSO"] }
      }
    },
    "PartnerRef": {
      "type": "object",
      "required": ["partnerId", "productCode"],
      "properties": {
        "partnerId": { "type": "string", "minLength": 1 },
        "productCode": { "type": "string", "minLength": 1 },
        "billerCode": { "type": "string" }
      }
    },
    "EncryptedPin": {
      "type": "object",
      "description": "PIN encrypted with the core's public key (RSA-OAEP, SHA-256); the middleware never decrypts it.",
      "required": ["keyId", "ciphertext"],
      "properties": {
        "keyId": { "type": "string", "minLength": 1 },
        "ciphertext": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9+/]+={0,2}$", "contentEncoding": "base64" }
      }
    },
    "StringMap": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
