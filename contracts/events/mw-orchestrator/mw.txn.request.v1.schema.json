{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.upay.mw/events/mw-orchestrator/mw.txn.request.v1.schema.json",
  "title": "mw.txn.request.v1",
  "description": "Transaction request from a channel service to mw-orchestrator (spec 5.1, 6.2). Key: txnId. Consumers ignore unknown fields; only additive changes within v1.",
  "type": "object",
  "required": ["schemaVersion", "txnId", "idempotencyKey", "correlationId", "channel", "txnType", "initiator", "debitParty", "creditParty", "amount", "requestedAt"],
  "properties": {
    "schemaVersion": { "$ref": "../../common/defs.v1.schema.json#/$defs/SchemaVersion", "const": 1 },
    "txnId": { "$ref": "../../common/defs.v1.schema.json#/$defs/TxnId" },
    "idempotencyKey": { "$ref": "../../common/defs.v1.schema.json#/$defs/IdempotencyKey" },
    "correlationId": { "$ref": "../../common/defs.v1.schema.json#/$defs/CorrelationId" },
    "channel": { "$ref": "../../common/defs.v1.schema.json#/$defs/Channel" },
    "txnType": { "$ref": "../../common/defs.v1.schema.json#/$defs/TxnType" },
    "initiator": { "$ref": "../../common/defs.v1.schema.json#/$defs/Party" },
    "debitParty": { "$ref": "../../common/defs.v1.schema.json#/$defs/Party" },
    "creditParty": { "$ref": "../../common/defs.v1.schema.json#/$defs/Party" },
    "amount": { "$ref": "../../common/defs.v1.schema.json#/$defs/Amount" },
    "partner": { "$ref": "../../common/defs.v1.schema.json#/$defs/PartnerRef" },
    "originalTxnId": {
      "$ref": "../../common/defs.v1.schema.json#/$defs/TxnId",
      "description": "Set for REVERSAL: the transaction being compensated."
    },
    "encryptedPin": { "$ref": "../../common/defs.v1.schema.json#/$defs/EncryptedPin" },
    "requestedAt": { "type": "string", "format": "date-time" },
    "locale": { "$ref": "../../common/defs.v1.schema.json#/$defs/Locale" },
    "metadata": {
      "$ref": "../../common/defs.v1.schema.json#/$defs/StringMap",
      "description": "Channel extras (device ID, USSD session, IP); masked by policy."
    },
    "attributes": {
      "$ref": "../../common/defs.v1.schema.json#/$defs/StringMap",
      "description": "Product-specific data (bill number, meter number, account number)."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "txnType": { "const": "REVERSAL" } }, "required": ["txnType"] },
      "then": { "required": ["originalTxnId"] }
    }
  ]
}
