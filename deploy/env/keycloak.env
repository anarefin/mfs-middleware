# Keycloak master-realm bootstrap admin (identity only). The password and the realm
# credentials come from the generated .env (scripts/gen-dev-env.sh); see compose.yml.
KC_BOOTSTRAP_ADMIN_USERNAME=kc-admin
# Production mode on PostgreSQL (database and role from postgres/initdb; the password is
# KC_DB_PASSWORD in the generated .env).
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=keycloak
# Behind APISIX: HTTP inside the ops network, X-Forwarded-* headers trusted, hostname
# taken from the request until a public hostname is fixed; health on management port 9000.
KC_HTTP_ENABLED=true
KC_HTTP_PORT=8080
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME_STRICT=false
KC_HEALTH_ENABLED=true
# Pool cap (default 100); counted in the postgres max_connections sizing in compose.yml.
KC_DB_POOL_MAX_SIZE=20
