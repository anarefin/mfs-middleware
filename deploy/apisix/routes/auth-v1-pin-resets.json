{
  "name": "auth-v1-pin-resets",
  "desc": "mw-auth PIN reset status (18.7; ticket 70, routed in 76): GET /auth/v1/pin-resets/{id}, the app polls it while the core checks the factors; only the reset device (X-Device-Id) sees it. No body, quota per address",
  "methods": [
    "GET"
  ],
  "plugins": {
    "client-control": {
      "max_body_size": 1024
    },
    "limit-count": {
      "count": 60,
      "time_window": 60,
      "key_type": "var",
      "key": "remote_addr",
      "group": "auth-v1-pin-resets",
      "rejected_code": 429,
      "show_limit_quota_header": true,
      "policy": "redis",
      "redis_host": "valkey",
      "redis_port": 6379,
      "redis_password": "$env://VALKEY_PASSWORD",
      "redis_database": 0,
      "redis_timeout": 1000,
      "allow_degradation": true
    }
  },
  "upstream": {
    "type": "roundrobin",
    "scheme": "http",
    "timeout": {
      "connect": 5,
      "send": 10,
      "read": 10
    },
    "nodes": {
      "mw-auth:8080": 1
    }
  },
  "uri": "/auth/v1/pin-resets/*"
}
