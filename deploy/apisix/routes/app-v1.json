{
  "name": "app-v1",
  "desc": "Mobile apps API v1 (spec 8.2, 8.3): Keycloak realm customers bearer JWT verified with the realm's JWKS (verified again upstream), body cap (mw-app-gateway checks the submit body schema on the bytes the device signed), quota per token subject in Valkey",
  "uri": "/app/v1/*",
  "methods": ["GET", "POST"],
  "plugins": {
    "client-control": {
      "max_body_size": 65536
    },
    "openid-connect": {
      "discovery": "http://keycloak:8080/realms/customers/.well-known/openid-configuration",
      "client_id": "mw-app",
      "bearer_only": true,
      "use_jwks": true,
      "realm": "customers",
      "iat_slack": 10,
      "set_access_token_header": false,
      "set_userinfo_header": false,
      "set_id_token_header": false
    },
    "serverless-pre-function": {
      "phase": "access",
      "functions": ["@lua:lua/consumer-from-jwt.lua"]
    },
    "limit-count": {
      "count": 120,
      "time_window": 60,
      "key_type": "var",
      "key": "mw_consumer",
      "group": "app-v1",
      "rejected_code": 429,
      "show_limit_quota_header": true,
      "policy": "redis",
      "redis_host": "valkey",
      "redis_port": 6379,
      "redis_password": "$env://VALKEY_PASSWORD",
      "redis_database": 0,
      "redis_timeout": 1000,
      "allow_degradation": true
    }
  },
  "upstream": {
    "type": "roundrobin",
    "scheme": "http",
    "timeout": { "connect": 5, "send": 10, "read": 35 },
    "nodes": { "mw-app-gateway:8080": 1 }
  }
}
