{
  "name": "auth-v1",
  "desc": "mw-auth public API v1 (18.7, D21; tickets 68-70, 76): OTP, binding, login, refresh, logout, PIN set/change/reset (POST, PUT). No auth plugin (mw-auth checks device signature, OTP, PIN, own tokens). No rewrite. Quota per hashed MSISDN and per address",
  "uri": "/auth/v1/*",
  "methods": ["POST", "PUT"],
  "plugins": {
    "client-control": {
      "max_body_size": 16384
    },
    "serverless-pre-function": {
      "phase": "access",
      "functions": ["@lua:lua/auth-rate-key.lua"]
    },
    "limit-count": {
      "count": 20,
      "time_window": 60,
      "key_type": "var",
      "key": "mw_auth_key",
      "group": "auth-v1",
      "rejected_code": 429,
      "show_limit_quota_header": true,
      "policy": "redis",
      "redis_host": "valkey",
      "redis_port": 6379,
      "redis_password": "$env://VALKEY_PASSWORD",
      "redis_database": 0,
      "redis_timeout": 1000,
      "allow_degradation": true
    },
    "limit-req": {
      "rate": 5,
      "burst": 20,
      "key_type": "var",
      "key": "remote_addr",
      "rejected_code": 429,
      "nodelay": true,
      "allow_degradation": true
    }
  },
  "upstream": {
    "type": "roundrobin",
    "scheme": "http",
    "timeout": { "connect": 5, "send": 10, "read": 15 },
    "nodes": { "mw-auth:8080": 1 }
  }
}
