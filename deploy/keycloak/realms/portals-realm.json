{
  "realm": "portals",
  "displayName": "Bits org and SP portals",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "passwordPolicy": "length(12) and notUsername(undefined) and passwordHistory(5)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 86400,
  "roles": {
    "realm": [
      {
        "name": "org-maker",
        "description": "Org portal maker (bulk upload)"
      },
      {
        "name": "org-checker",
        "description": "Org portal checker (bulk approve)"
      },
      {
        "name": "sp-viewer",
        "description": "Service provider transaction query"
      }
    ]
  },
  "clients": [
    {
      "clientId": "mw-portal",
      "name": "Org and SP portals",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "https://localhost/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "orgId",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "orgId",
            "claim.name": "orgId",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "org-maker01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Maker",
      "lastName": "Test",
      "email": "org-maker01@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_PORTALS_TEST_PASSWORD}",
          "temporary": false
        },
        {
          "type": "otp",
          "userLabel": "dev/test pre-set (KC_PORTALS_TEST_TOTP_SECRET)",
          "secretData": "{\"value\":\"${KC_PORTALS_TEST_TOTP_SECRET}\"}",
          "credentialData": "{\"subType\":\"totp\",\"digits\":6,\"counter\":0,\"period\":30,\"algorithm\":\"HmacSHA256\"}"
        }
      ],
      "realmRoles": [
        "org-maker"
      ],
      "attributes": {
        "orgId": [
          "ORG001"
        ]
      }
    },
    {
      "username": "org-checker01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Checker",
      "lastName": "Test",
      "email": "org-checker01@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_PORTALS_TEST_PASSWORD}",
          "temporary": false
        },
        {
          "type": "otp",
          "userLabel": "dev/test pre-set (KC_PORTALS_TEST_TOTP_SECRET)",
          "secretData": "{\"value\":\"${KC_PORTALS_TEST_TOTP_SECRET}\"}",
          "credentialData": "{\"subType\":\"totp\",\"digits\":6,\"counter\":0,\"period\":30,\"algorithm\":\"HmacSHA256\"}"
        }
      ],
      "realmRoles": [
        "org-checker"
      ],
      "attributes": {
        "orgId": [
          "ORG001"
        ]
      }
    },
    {
      "username": "org-makerchecker01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "MakerChecker",
      "lastName": "Test",
      "email": "org-makerchecker01@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_PORTALS_TEST_PASSWORD}",
          "temporary": false
        },
        {
          "type": "otp",
          "userLabel": "dev/test pre-set (KC_PORTALS_TEST_TOTP_SECRET)",
          "secretData": "{\"value\":\"${KC_PORTALS_TEST_TOTP_SECRET}\"}",
          "credentialData": "{\"subType\":\"totp\",\"digits\":6,\"counter\":0,\"period\":30,\"algorithm\":\"HmacSHA256\"}"
        }
      ],
      "realmRoles": [
        "org-maker",
        "org-checker"
      ],
      "attributes": {
        "orgId": [
          "ORG001"
        ]
      }
    },
    {
      "username": "org-checker02",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Checker",
      "lastName": "Test",
      "email": "org-checker02@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_PORTALS_TEST_PASSWORD}",
          "temporary": false
        },
        {
          "type": "otp",
          "userLabel": "dev/test pre-set (KC_PORTALS_TEST_TOTP_SECRET)",
          "secretData": "{\"value\":\"${KC_PORTALS_TEST_TOTP_SECRET}\"}",
          "credentialData": "{\"subType\":\"totp\",\"digits\":6,\"counter\":0,\"period\":30,\"algorithm\":\"HmacSHA256\"}"
        }
      ],
      "realmRoles": [
        "org-checker"
      ],
      "attributes": {
        "orgId": [
          "ORG002"
        ]
      }
    },
    {
      "username": "sp-viewer01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Viewer",
      "lastName": "Test",
      "email": "sp-viewer01@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_PORTALS_TEST_PASSWORD}",
          "temporary": false
        },
        {
          "type": "otp",
          "userLabel": "dev/test pre-set (KC_PORTALS_TEST_TOTP_SECRET)",
          "secretData": "{\"value\":\"${KC_PORTALS_TEST_TOTP_SECRET}\"}",
          "credentialData": "{\"subType\":\"totp\",\"digits\":6,\"counter\":0,\"period\":30,\"algorithm\":\"HmacSHA256\"}"
        }
      ],
      "realmRoles": [
        "sp-viewer"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"orgId\",\"displayName\":\"Organisation id\",\"validations\":{\"pattern\":{\"pattern\":\"^[A-Za-z0-9_-]{1,32}$\",\"error-message\":\"orgId must be 1 to 32 of A-Z a-z 0-9 _ -\"}},\"annotations\":{},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "browserFlow": "browser-mfa",
  "authenticatorConfig": [],
  "authenticationFlows": [
    {
      "alias": "browser-mfa",
      "description": "Portal login: password and TOTP both required (spec 18.2, ticket 73)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "browser-mfa forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-mfa forms",
      "description": "Username/password, then OTP (never conditional)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ]
}
