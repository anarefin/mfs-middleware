{
  "realm": "services",
  "displayName": "Bits internal services (client credentials)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "passwordPolicy": "length(12) and notUsername(undefined) and passwordHistory(5)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 86400,
  "roles": {
    "realm": [
      {
        "name": "internal-api",
        "description": "Service calling another service's internal API (/internal/v1/**)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "mw-portal-api",
      "name": "mw-portal-api (SP transaction query on mw-orchestrator)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_MW_PORTAL_API_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "aud-mw-orchestrator",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mw-orchestrator",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mw-admin-api",
      "name": "mw-admin-api (operations: transaction and audit search, key management on mw-crypto)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_MW_ADMIN_API_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "aud-mw-orchestrator",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mw-orchestrator",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "aud-mw-audit-dw",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mw-audit-dw",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "aud-mw-crypto",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mw-crypto",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mw-audit-dw",
      "name": "mw-audit-dw (mw-crypto: signs the daily audit anchor)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_MW_AUDIT_DW_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "aud-mw-crypto",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mw-crypto",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mw-auth",
      "name": "mw-auth (mw-crypto: MSISDN tokens, envelope encryption; later PIN verify and JWS)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_MW_AUTH_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "aud-mw-crypto",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mw-crypto",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mw-app-gateway",
      "name": "mw-app-gateway (mw-auth internal API: device keys and sessions of the device gate; mw-orchestrator query API: wallet history)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_MW_APP_GATEWAY_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "aud-mw-auth",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mw-auth",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "aud-mw-orchestrator",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mw-orchestrator",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mw-ussd",
      "name": "mw-ussd (mw-auth internal API: transaction authorisation, ticket 72)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_MW_USSD_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "aud-mw-auth",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mw-auth",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mw-checkout",
      "name": "mw-checkout (mw-auth internal API: checkout OTP and transaction authorisation, ticket 72)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_MW_CHECKOUT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "aud-mw-auth",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mw-auth",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mw-orchestrator",
      "name": "mw-orchestrator (the core wallet REST API /core/v1, ADR D31, ticket 95a)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_MW_ORCHESTRATOR_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "aud-mw-core-mock",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mw-core-mock",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mw-simulators",
      "name": "mw-simulators (dev/test only: the trust bank mock reads mw-core-mock's statements, ticket 123)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_MW_SIMULATORS_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "aud-mw-core-mock",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mw-core-mock",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-mw-portal-api",
      "enabled": true,
      "serviceAccountClientId": "mw-portal-api",
      "realmRoles": [
        "internal-api"
      ]
    },
    {
      "username": "service-account-mw-admin-api",
      "enabled": true,
      "serviceAccountClientId": "mw-admin-api",
      "realmRoles": [
        "internal-api"
      ]
    },
    {
      "username": "service-account-mw-audit-dw",
      "enabled": true,
      "serviceAccountClientId": "mw-audit-dw",
      "realmRoles": [
        "internal-api"
      ]
    },
    {
      "username": "service-account-mw-auth",
      "enabled": true,
      "serviceAccountClientId": "mw-auth",
      "realmRoles": [
        "internal-api"
      ]
    },
    {
      "username": "service-account-mw-app-gateway",
      "enabled": true,
      "serviceAccountClientId": "mw-app-gateway",
      "realmRoles": [
        "internal-api"
      ]
    },
    {
      "username": "service-account-mw-ussd",
      "enabled": true,
      "serviceAccountClientId": "mw-ussd",
      "realmRoles": [
        "internal-api"
      ]
    },
    {
      "username": "service-account-mw-checkout",
      "enabled": true,
      "serviceAccountClientId": "mw-checkout",
      "realmRoles": [
        "internal-api"
      ]
    }
  ]
