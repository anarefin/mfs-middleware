{
  "realm": "portals",
  "displayName": "upay org and SP portals",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "org-maker",
        "description": "Org portal maker (bulk upload)"
      },
      {
        "name": "org-checker",
        "description": "Org portal checker (bulk approve)"
      },
      {
        "name": "sp-viewer",
        "description": "Service provider transaction query"
      }
    ]
  },
  "clients": [
    {
      "clientId": "mw-portal",
      "name": "Org and SP portals",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "https://localhost/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "orgId",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "orgId",
            "claim.name": "orgId",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "org-maker01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Maker",
      "lastName": "Test",
      "email": "org-maker01@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_PORTALS_TEST_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "org-maker"
      ],
      "attributes": {
        "orgId": [
          "ORG001"
        ]
      }
    },
    {
      "username": "org-checker01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Checker",
      "lastName": "Test",
      "email": "org-checker01@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_PORTALS_TEST_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "org-checker"
      ],
      "attributes": {
        "orgId": [
          "ORG001"
        ]
      }
    },
    {
      "username": "org-makerchecker01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "MakerChecker",
      "lastName": "Test",
      "email": "org-makerchecker01@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_PORTALS_TEST_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "org-maker",
        "org-checker"
      ],
      "attributes": {
        "orgId": [
          "ORG001"
        ]
      }
    },
    {
      "username": "org-checker02",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Checker",
      "lastName": "Test",
      "email": "org-checker02@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_PORTALS_TEST_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "org-checker"
      ],
      "attributes": {
        "orgId": [
          "ORG002"
        ]
      }
    },
    {
      "username": "sp-viewer01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Viewer",
      "lastName": "Test",
      "email": "sp-viewer01@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_PORTALS_TEST_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "sp-viewer"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"orgId\",\"displayName\":\"Organisation id\",\"validations\":{\"pattern\":{\"pattern\":\"^[A-Za-z0-9_-]{1,32}$\",\"error-message\":\"orgId must be 1 to 32 of A-Z a-z 0-9 _ -\"}},\"annotations\":{},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
