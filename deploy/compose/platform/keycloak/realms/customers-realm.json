{
  "realm": "customers",
  "displayName": "upay customers and apps",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Customer app user"
      },
      {
        "name": "agent",
        "description": "Agent app user"
      },
      {
        "name": "merchant",
        "description": "Merchant app user"
      }
    ]
  },
  "clients": [
    {
      "clientId": "mw-app",
      "name": "upay mobile apps",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "https://localhost/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "msisdn",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "msisdn",
            "claim.name": "msisdn",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "customer01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Customer",
      "lastName": "Test",
      "email": "customer01@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_CUSTOMERS_TEST_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "customer"
      ],
      "attributes": {
        "msisdn": [
          "01711000001"
        ]
      }
    },
    {
