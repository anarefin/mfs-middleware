{
  "realm": "ops",
  "displayName": "Bits operations",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Read-only: search transactions, timelines and audit trails (spec 15.4)"
      },
      {
        "name": "ops-maker",
        "description": "Raise manual TSQ, retry, commit/release and reversal requests"
      },
      {
        "name": "ops-checker",
        "description": "Approve or reject ops-maker requests (a second user)"
      },
      {
        "name": "ops-emergency",
        "description": "Emergency changes, post-approved within 24 h"
      },
      {
        "name": "integration-maker",
        "description": "Raise partner, mapping and routing changes"
      },
      {
        "name": "integration-checker",
        "description": "Approve or reject integration-maker requests"
      },
      {
        "name": "recon-maker",
        "description": "Propose reconciliation resolutions"
      },
      {
        "name": "recon-checker",
        "description": "Approve or reject reconciliation resolutions"
      },
      {
        "name": "compliance-officer",
        "description": "Compliance: sees unmasked MSISDN/NID (every reveal audited)"
      },
      {
        "name": "security-admin",
        "description": "Users and roles, access review export"
      },
      {
        "name": "auditor",
        "description": "Read-only, all modules incl. audit; sees unmasked MSISDN/NID (audited)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "mw-admin-ui",
      "name": "Admin console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://localhost/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost/console/*"
      },
      "protocol": "openid-connect"
    },
    {
      "clientId": "mw-e2e-ops",
      "name": "e2e operators (dev only, password + TOTP grant via the test-only route auth-ops-token)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "ops-viewer01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Viewer",
      "lastName": "Test",
      "email": "ops-viewer01@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_OPS_TEST_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "viewer"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ]
    },
    {
      "username": "ops-maker01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Maker",
      "lastName": "Test",
      "email": "ops-maker01@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_OPS_TEST_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "viewer",
        "ops-maker"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ]
    },
    {
      "username": "ops-checker01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Checker",
      "lastName": "Test",
      "email": "ops-checker01@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_OPS_TEST_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "viewer",
        "ops-checker"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ]
    },
    {
      "username": "ops-admin01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Test",
      "email": "ops-admin01@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_OPS_TEST_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "viewer",
        "integration-maker",
        "security-admin"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ]
    },
    {
      "username": "ops-compliance01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Compliance",
      "lastName": "Test",
      "email": "ops-compliance01@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_OPS_TEST_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "compliance-officer"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ]
    },
    {
      "username": "ops-auditor01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Auditor",
      "lastName": "Test",
      "email": "ops-auditor01@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_OPS_TEST_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "auditor"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ]
    },
    {
      "username": "ops-e2e-maker01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "E2e",
      "lastName": "Maker",
      "email": "ops-e2e-maker01@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_OPS_TEST_PASSWORD}",
          "temporary": false
        },
        {
          "type": "otp",
          "userLabel": "e2e (dev only)",
          "secretData": "{\"value\":\"${KC_OPS_TEST_TOTP_SECRET}\"}",
          "credentialData": "{\"subType\":\"totp\",\"digits\":6,\"counter\":0,\"period\":30,\"algorithm\":\"HmacSHA256\"}"
        }
      ],
      "realmRoles": [
        "viewer",
        "ops-maker"
      ]
    },
    {
      "username": "ops-e2e-checker01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "E2e",
      "lastName": "Checker",
      "email": "ops-e2e-checker01@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_OPS_TEST_PASSWORD}",
          "temporary": false
        },
        {
          "type": "otp",
          "userLabel": "e2e (dev only)",
          "secretData": "{\"value\":\"${KC_OPS_TEST_TOTP_SECRET}\"}",
          "credentialData": "{\"subType\":\"totp\",\"digits\":6,\"counter\":0,\"period\":30,\"algorithm\":\"HmacSHA256\"}"
        }
      ],
      "realmRoles": [
        "viewer",
        "ops-checker"
      ]
    }
  ],
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "browserFlow": "browser-mfa",
  "authenticatorConfig": [],
  "authenticationFlows": [
    {
      "alias": "browser-mfa",
      "description": "Ops console login: password and TOTP both required (spec 18.2)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "browser-mfa forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-mfa forms",
      "description": "Username/password, then OTP (never conditional)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ]
}
