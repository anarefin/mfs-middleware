# Short timers for test runs: `docker compose --env-file .env --env-file test-timers.env` loads this file after deploy/.env
# (docker compose --env-file deploy/.env --env-file deploy/test-timers.env). Each variable fills a
# "timer" placeholder of deploy/docker-compose.yml, whose default is the production value of the
# service's application.yml; nothing in application.yml changes. Not secrets.

# mw-orchestrator status inquiry of UNKNOWN outcomes (spec 7.4): production 30s,1m,2m,5m,15m,1h
# first slot 6 s: a lost core reply must still be unresolved when the app's 7 s reply budget
# ends, so the suite sees the 202 PROCESSING path (posting timeout 2 s + 6 s > 7 s)
MW_ORCHESTRATOR_INQUIRY_SCHEDULE=6s,2s,5s,10s,30s,1m
# core command deadlines (5s) and the partner deadline (30s; above the partner limits below)
MW_ORCHESTRATOR_POSTING_TIMEOUT=2s
MW_ORCHESTRATOR_HOLDING_TIMEOUT=2s
MW_ORCHESTRATOR_PARTNER_TIMEOUT=8s
# a "not found" answer is believed this long after the original call could last have arrived (30s)
MW_ORCHESTRATOR_INQUIRY_NOT_FOUND_GRACE=2s
# REVERSING resends every retry-timeout, MANUAL_REVIEW after this (60s)
MW_ORCHESTRATOR_REVERSING_TIMEOUT=5s

# Non-blocking retry topics retry.1..3 of every mw-* service (19.2): production 10s,1m,10m
MW_KAFKA_RETRY_DELAYS=1s,1s,1s

# mw-portal-api bulk dispatch rate cap, child txns per second over all batches (spec 9.4; 50):
# kept at 50. At 100 or 200/s the low-resource stack answers core validations past their 5 s
# deadline (MW-TMO-001 rows in the API suite's 10,000-row payout, folder 90); at 50/s it passes
MW_BULK_RATE_PER_SECOND=50

# mw-checkout merchant IPN retry schedule (spec 9.3; packaged 1m,5m,30m,2h,6h, dev stack
# 10s,20s,30s,1m,2m) and its poll period
MW_CHECKOUT_IPN_RETRY_DELAYS=1s,2s,3s,5s,10s
MW_CHECKOUT_IPN_POLL_PERIOD=1s

# Synchronous wait of an app / checkout request for the terminal status before it answers 202
# (spec 7.5; 25s): an outcome that resolves late (status inquiry) answers 202 sooner. Above the
# about 5.5 s a lost hold reply takes to fail (holding timeout 2 s, then the hold query), so that
# is still answered 504.
MW_APP_REPLY_BUDGET=7s
MW_CHECKOUT_REPLY_BUDGET=7s

# Partner time limits of the dev partners (OCS 20 s in mw-admin-api, seeded by mw-seeder;
# billagg / c2wbank 25 s, read 27 s) and the simulators' timeout hold (30 s, above them)
MW_SEED_OCS_TIMEOUT_MS=4000
MW_BILLAGG_TIMEOUT_MS=4000
MW_BILLAGG_READ_TIMEOUT_MS=5000
MW_C2WBANK_TIMEOUT_MS=4000
MW_C2WBANK_READ_TIMEOUT_MS=5000
MW_SIM_TIMEOUT_DELAY=7s
